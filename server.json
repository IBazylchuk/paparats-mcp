    "mcp-server",
    "mcp",
    "claude-code",
    "cursor",
    "windsurf",
    "semantic-code-search",
    "code-search",
    "self-hosted",
    "qdrant",
    "llama-cpp",
    "local-first",
    "tree-sitter",
    "multi-repo",
    "rag",
    "codex",
    "codebase-search",
    "ai-coding",
    "code-intelligence",
    "vector-search"
  ],
  "repository": {
    "url": "https://github.com/IBazylchuk/paparats-mcp",
    "source": "github",
    "subfolder": "packages/server"
