# Copy to .env next to docker-compose.yml. Every line is optional.

# Voyage AI (docker-compose.voyage.yml only)
# VOYAGE_API_KEY=
# Code model (default voyage-code-3); changing it means indexing everything again
# EMBEDDING_MODEL=voyage-code-4

# Private GitHub repositories in projects.yml
# GITHUB_TOKEN=

# Index each repo's markdown for search_docs
# INDEX_DOCS=true

# Host ports
# PAPARATS_PORT=9876
# INDEXER_PORT=9877
# QDRANT_PORT=6333

# Full pass over every repo (changes are also checked every 10 minutes)
# CRON=0 */6 * * *
