# Copy to .env next to docker-compose.yml. Every line is optional.

# Voyage AI (docker-compose.voyage.yml only)
# VOYAGE_API_KEY=
# Code model (default voyage-code-3); changing it means indexing everything again
# EMBEDDING_MODEL=voyage-code-4

# Private GitHub repositories in projects.yml
# GITHUB_TOKEN=

# API key for the server and the indexer (clients send Authorization: Bearer <key>).
# Unset, they answer anyone who reaches the ports: fine on localhost or behind a VPN.
# At least 16 characters, e.g. the output of: openssl rand -hex 32
# PAPARATS_API_KEY=

# Index each repo's markdown for search_docs
# INDEX_DOCS=true

# Qdrant (it holds the indexed code) and the embed server have no auth: they are
# published on this machine only. 0.0.0.0 publishes them to the network.
# QDRANT_BIND=127.0.0.1
# EMBED_BIND=127.0.0.1

# Host ports
# PAPARATS_PORT=9876
# INDEXER_PORT=9877
# QDRANT_PORT=6333

# Full pass over every repo (changes are also checked every 10 minutes)
# CRON=0 */6 * * *
