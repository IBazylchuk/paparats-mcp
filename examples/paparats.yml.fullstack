# Multi-language project (e.g. monorepo with backend + infra)
group: "my-platform"
language: [typescript, terraform]

indexing:
  paths: ["src/", "infra/"]
  exclude: ["node_modules/**", "dist/**", ".terraform/**"]

embeddings:
  provider: "llama"
  model: "bge-code-v1"  # llama-swap route → bge-code-v1 GGUF (the default)
